# Heng Seng Sentiment Agent - Environment Template
# Duplicate this file to .env and insert your personal API keys.

# Apify REST API Token (Used for Telegram & LIHKG scraping)
# Obtain at: https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_api_token_here

# Exa AI News API Key (Used for financial news collection)
# Obtain at: https://dashboard.exa.ai/api-keys
EXA_API_KEY=your_exa_api_key_here

